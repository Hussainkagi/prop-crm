    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role_name\": \"Senior Manager\",\n  \"role_description\": \"Senior management level role\",\n  \"role_level\": 3\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/roles",
          "host": ["{{base_url}}"],
          "path": ["api", "roles"]
        }
      }
    },
