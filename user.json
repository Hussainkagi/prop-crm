              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/login",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "login"]
            },
            "description": "Test failed login — should return 401 with remaining attempts"
          },
          "response": []
        },
        {
          "name": "Login - Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('token', res.data.tokens.accessToken);",
                  "    console.log('✅ Manager token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager\",\n  \"password\": \"Manager@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/login",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "login"]
            },
            "description": "Login as manager to test manager-level permissions"
          },
          "response": []
        },
        {
          "name": "Register - Missing developer_id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"no_dev_user\",\n  \"password\": \"SecurePass@123\",\n  \"email_id\": \"nodev@example.com\",\n  \"first_name\": \"No\",\n  \"last_name\": \"Dev\",\n  \"role_id\": 4\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Should return 400 Validation Error — developer_id is required for all users"
          },
          "response": []
        },
        {
          "name": "Register - Invalid developer_id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bad_dev_user\",\n  \"password\": \"SecurePass@123\",\n  \"email_id\": \"baddev@example.com\",\n  \"first_name\": \"Bad\",\n  \"last_name\": \"Dev\",\n  \"role_id\": 4,\n  \"developer_id\": 99999\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Should return 404 Not Found — developer with ID 99999 does not exist"
          },
          "response": []
        },
        {
          "name": "Register - Inactive Developer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"inactive_dev_user\",\n  \"password\": \"SecurePass@123\",\n  \"email_id\": \"inactivedev@example.com\",\n  \"first_name\": \"Inactive\",\n  \"last_name\": \"Dev\",\n  \"role_id\": 4,\n  \"developer_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Should return 400 Validation Error — cannot assign user to an Inactive or Blacklisted developer. Update developer_id to point to an actual Inactive/Blacklisted developer in your DB."
          },
          "response": []
        },
        {
          "name": "Register - Duplicate Username",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"SecurePass@123\",\n  \"email_id\": \"newemail@example.com\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"role_id\": 4,\n  \"developer_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Should return 409 Conflict — username already exists"
          },
          "response": []
        },
        {
          "name": "Register - Weak Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser123\",\n  \"password\": \"weak\",\n  \"email_id\": \"newuser@example.com\",\n  \"first_name\": \"New\",\n  \"last_name\": \"User\",\n  \"role_id\": 4,\n  \"developer_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Should return 400 Validation Error — password too weak"
          },
          "response": []
        },
        {
          "name": "Access Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Should return 401 Unauthorized — no token provided"
          },
          "response": []
        },
        {
          "name": "Get All Users - With Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=1&limit=5&search=admin&status=Active",
              "host": ["{{base_url}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" },
                { "key": "search", "value": "admin" },
                { "key": "status", "value": "Active" }
              ]
            },
            "description": "Test pagination and search filters"
          },
          "response": []
        }
      ]
    }
  ]
}
